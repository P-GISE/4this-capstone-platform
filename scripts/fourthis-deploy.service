[Unit]
Description=Deploy the verified 4this main application image
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/libexec/fourthis-deploy-poll
TimeoutStartSec=30min
TimeoutStopSec=10min
KillMode=mixed
UMask=0077
StandardOutput=journal
StandardError=journal
