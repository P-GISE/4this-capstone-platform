<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.test.ai.ConversationRepository">

    <!-- 결과 매핑 -->
    <resultMap id="ConversationResultMap" type="com.example.test.ai.Conversation">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="question" column="question"/>
        <result property="answer" column="answer"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 사용자별 대화 목록 조회 -->
    <select id="findByUserIdOrderByCreatedAt" resultMap="ConversationResultMap">
        SELECT id, user_id, question, answer, created_at
        FROM conversations
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <!-- 대화 저장 -->
    <insert id="save" parameterType="com.example.test.ai.Conversation" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO conversations (user_id, question, answer, created_at)
        VALUES (#{userId}, #{question}, #{answer}, #{createdAt})
    </insert>

    <!-- 대화 삭제 -->
    <delete id="deleteById">
        DELETE FROM conversations WHERE id = #{id}
    </delete>

</mapper> 